{
  "name": "dsh-theme-warm",
  "version": "1.0.0",
  "description": "Warm cream-and-terracotta theme for the DeepSeek Harness Web GUI, with a sidebar texture and a main-area ornament served by the plugin's own host half.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "media",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-theme",
    "deepseek-harness",
    "theme",
    "wallpaper"
  ],
  "license": "MIT"
}
